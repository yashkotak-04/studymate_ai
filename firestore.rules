rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document path
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Canonical User-Scoped Data Structure
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && 
        (request.resource.data.userId == null || request.resource.data.userId == userId) &&
        (request.resource.data.dailyStudyGoalMinutes == null || request.resource.data.dailyStudyGoalMinutes >= 0) &&
        (request.resource.data.currentStreak == null || request.resource.data.currentStreak >= 0);
      
      // Chat Threads and nested messages
      match /chatThreads/{threadId} {
        allow read, write: if isOwner(userId);
        
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Quiz and Mock Test Sessions
      match /quizzes/{quizId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          (request.resource.data.score == null || request.resource.data.score >= 0) &&
          (request.resource.data.totalQuestions == null || request.resource.data.totalQuestions >= 0) &&
          (request.resource.data.score == null || request.resource.data.totalQuestions == null || request.resource.data.score <= request.resource.data.totalQuestions);
      }

      // Summaries
      match /summaries/{summaryId} {
        allow read, write: if isOwner(userId);
      }

      // Subject Progress
      match /subjectProgress/{subjectId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          (request.resource.data.accuracy == null || (request.resource.data.accuracy >= 0 && request.resource.data.accuracy <= 100)) &&
          (request.resource.data.totalQuizzes == null || request.resource.data.totalQuizzes >= 0);
      }
      
      // Daily Study Stats
      match /dailyStats/{date} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          (request.resource.data.minutesStudied == null || request.resource.data.minutesStudied >= 0);
      }
      
      // Study Activities Log
      match /activities/{activityId} {
        allow read, write: if isOwner(userId);
      }
      
      // Study Plans
      match /studyPlans/{planId} {
        allow read, write: if isOwner(userId);
      }

      // Personalized Recommendations
      match /recommendations/{recommendationId} {
        allow read, write: if isOwner(userId);
      }

      // Aggregates for All-Time Analytics
      match /aggregates/{aggregateId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          (request.resource.data.accuracy == null || (request.resource.data.accuracy >= 0 && request.resource.data.accuracy <= 100)) &&
          (request.resource.data.totalQuizzes == null || request.resource.data.totalQuizzes >= 0);
      }

      // Settings and Preferences
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Global Subjects Catalog (Read-only for all authenticated users)
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only manageable via Firebase Admin / Console
    }
  }
}
